---
import PublicLayout from '@/layouts/PublicLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import IndexLabel from '@/features/support/components/IndexLabel.astro';
import ContactForm from '@/features/contact/components/ContactForm';
import { contactChannels } from '@/features/contact/data';
---

<PublicLayout title="Contacto | Shepwashi Robotics" description="Cuéntanos qué quieres automatizar. Te respondemos en menos de 24 horas con una recomendación de modelo y una propuesta inicial.">
  <div class="flex flex-col gap-3 md:gap-4">
    <!-- Encabezado -->
    <header class="flex flex-col gap-4 px-1 pt-7 pb-2 md:flex-row md:items-end md:justify-between md:gap-6 md:px-8 md:pt-14 md:pb-6">
      <div class="flex flex-col gap-4 md:gap-6">
        <p class="font-mono text-[11.5px] leading-[1.2] font-medium tracking-[0.92px] whitespace-pre text-muted uppercase">Inicio  /  Contacto</p>
        <h1 class="text-[40px] leading-[0.95] font-medium tracking-[-1.62px] text-ink md:text-[96px] md:leading-[0.9] md:tracking-[-5.30px]">Hablemos.</h1>
      </div>
      <p class="text-[15px] leading-[1.55] tracking-[-0.03px] text-ink-2 md:w-[440px] md:text-[17px] md:leading-normal md:tracking-[-0.095px]">
        <span class="md:hidden">Te respondemos en menos de 24 horas con una recomendación y una propuesta inicial.</span>
        <span class="hidden md:inline">Cuéntanos qué quieres automatizar. Te respondemos en menos de 24 horas con una recomendación de modelo y una propuesta inicial.</span>
      </p>
    </header>

    <div class="flex flex-col gap-3 md:flex-row md:gap-4">
      <!-- 01 Formulario -->
      <section class="flex min-w-0 flex-col gap-4 rounded-lg bg-surface px-5 pt-8 pb-5 md:flex-1 md:gap-5 md:rounded-xl md:p-12" aria-labelledby="formulario">
        <IndexLabel index="01" label="Formulario" class="hidden md:flex" />
        <h2 id="formulario" class="text-[19px] leading-[1.2] font-medium tracking-[-0.21px] text-ink md:text-[32px] md:leading-[1.08] md:tracking-[-1px]">Solicita una cotización o una demo</h2>
        <ContactForm client:load />
      </section>

      <!-- 02 Canales directos -->
      <aside class="flex flex-col overflow-hidden rounded-lg bg-panel md:w-[480px] md:shrink-0 md:rounded-xl" aria-labelledby="canales">
        <img src="/assets/contacto/canales.jpg" alt="Dos ejecutivos caminando junto a un robot de recepción" width="480" height="300" loading="lazy" class="hidden h-[min(300px,19svh)] w-full object-cover md:block" />
        <div class="flex flex-col gap-3.5 px-5 pt-7 pb-6 md:gap-5 md:p-9">
          <IndexLabel index="02" label="Canales directos" tone="panel" />
          <h2 id="canales" class="sr-only">Canales directos</h2>
          <ul class="flex flex-col gap-3.5 md:gap-5">
            {contactChannels.map((c) => (
              <li class="flex gap-3 border-t border-line-dark pt-3 md:gap-3.5 md:pt-4">
                <span class="mt-px grid size-9 shrink-0 place-items-center rounded-sm bg-navy-3 text-gold-soft md:mt-px md:size-10">
                  <Icon name={c.icon} size={20} />
                </span>
                <div class="flex min-w-0 flex-col gap-0.5 md:gap-1">
                  <p class="font-mono text-[11.5px] leading-[1.2] font-medium tracking-[0.92px] text-on-dark-muted uppercase">{c.label}</p>
                  {c.href ? (
                    <a href={c.href} class="text-[17px] leading-[1.3] font-medium tracking-[-0.085px] text-white transition-colors hover:text-gold-soft">{c.value}</a>
                  ) : (
                    <p class="text-[17px] leading-[1.3] font-medium tracking-[-0.085px] text-white">{c.value}</p>
                  )}
                </div>
              </li>
            ))}
          </ul>
          <p class="hidden items-center gap-2 pt-2 text-[14px] leading-[1.5] text-on-dark-muted md:flex">
            <span class="size-2 rounded-pill bg-gold-soft"></span>
            Respondemos en menos de 24 horas
          </p>
        </div>
      </aside>
    </div>
  </div>
</PublicLayout>
