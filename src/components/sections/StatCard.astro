---
// Stat Card (Design System · design-system/stat-card) y su variante en línea del Home.
//  - variant="card":   tarjeta 200×180 con icono arriba y valor/etiqueta abajo.
//  - variant="inline": cifra mono grande + unidad + etiqueta, sin fondo (Respaldo de fábrica, specs).
import Icon from '@/components/ui/Icon.astro';

interface Props {
  value: string;
  unit?: string;
  /** Unidad alterna en móvil (<lg); '' la oculta */
  unitMobile?: string;
  label: string;
  /** Etiqueta alterna en móvil (<lg) */
  labelMobile?: string;
  variant?: 'card' | 'inline';
  /** Nombre del icono (solo variant="card") */
  icon?: string;
  /** Texto sobre fondo oscuro fijo (bg-panel / bg-navy) */
  onDark?: boolean;
  class?: string;
}
const { value, unit, unitMobile, label, labelMobile, variant = 'inline', icon, onDark = false, class: className } = Astro.props;

const numberColor = onDark ? 'text-white' : 'text-ink';
const mutedColor = onDark ? 'text-on-dark-muted' : 'text-muted';
const hasMobileUnit = unitMobile !== undefined;
---

{variant === 'card' ? (
  <div class:list={['flex h-[180px] w-[200px] flex-col justify-between rounded-md bg-surface p-5', className]}>
    {icon && <Icon name={icon} size={22} class="text-ink" />}
    <div class="flex flex-col gap-1.5">
      <div class="flex items-baseline gap-1">
        <span class="font-mono text-[40px] leading-none tracking-[-1.6px] text-ink">{value}</span>
        {unit && <span class="font-mono text-[14px] leading-[1.35] text-muted">{unit}</span>}
      </div>
      <p class="text-[14px] leading-normal text-muted">{label}</p>
    </div>
  </div>
) : (
  <div class:list={['flex flex-col gap-1.5 lg:gap-2.5', className]}>
    <div class="flex items-baseline gap-1 lg:gap-1.5">
      <span class:list={['font-mono text-[32px] leading-none tracking-[-0.96px] lg:text-[44px] lg:tracking-[-1.76px]', numberColor]}>{value}</span>
      {unit && (
        <>
          {hasMobileUnit ? (
            <>
              {unitMobile && <span class:list={['font-mono text-[14px] leading-[1.35] lg:hidden', mutedColor]}>{unitMobile}</span>}
              <span class:list={['hidden font-mono text-[14px] leading-[1.35] lg:inline', mutedColor]}>{unit}</span>
            </>
          ) : (
            <span class:list={['font-mono text-[14px] leading-[1.35]', mutedColor]}>{unit}</span>
          )}
        </>
      )}
    </div>
    <p class:list={['text-[14px] leading-normal', mutedColor]}>
      {labelMobile ? (
        <>
          <span class="lg:hidden">{labelMobile}</span>
          <span class="hidden lg:inline">{label}</span>
        </>
      ) : (
        label
      )}
    </p>
  </div>
)}
