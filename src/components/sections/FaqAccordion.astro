---
// Acordeón de preguntas frecuentes (Home · FAQ). Sin JavaScript: <details> nativo; con `name`
// los ítems se comportan como grupo exclusivo (al abrir uno se cierra el otro).
import Icon from '@/components/ui/Icon.astro';

export interface FaqAccordionItem {
  question: string;
  answer: string;
  /** Respuesta alterna en móvil (<lg) cuando el copy del diseño es más corto */
  answerMobile?: string;
}
interface Props {
  items: FaqAccordionItem[];
  /** Índice del ítem abierto por defecto (-1 = ninguno). Por defecto 0 */
  openIndex?: number;
  /** Nombre del grupo exclusivo (único por acordeón en la página) */
  name?: string;
  class?: string;
}
const { items, openIndex = 0, name = 'faq', class: className } = Astro.props;
---

<div class:list={['lg:border-b lg:border-line', className]}>
  {
    items.map((item, i) => (
      <details name={name} open={i === openIndex} class="group border-t border-line pb-[18px] lg:pb-6">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 pt-[18px] lg:gap-6 lg:pt-6 [&::-webkit-details-marker]:hidden">
          <span class="min-w-px flex-1 text-[17px] leading-[1.3] font-medium tracking-[-0.085px] text-ink lg:py-[5px] lg:text-[21px] lg:leading-[1.25] lg:tracking-[-0.21px]">
            {item.question}
          </span>
          <span class="relative grid size-8 shrink-0 place-items-center rounded-pill border border-ink text-ink transition-colors group-open:bg-ink group-open:text-canvas lg:h-9 lg:w-[22px]">
            <span class="group-open:hidden"><Icon name="plus" size={14} /></span>
            <span class="hidden group-open:block"><Icon name="minus" size={14} /></span>
          </span>
        </summary>
        <p class="mt-3 text-[14px] leading-normal text-muted lg:mt-3.5 lg:max-w-[640px] lg:text-[16px] lg:leading-[1.55] lg:tracking-[-0.032px]">
          {item.answerMobile ? (
            <>
              <span class="lg:hidden">{item.answerMobile}</span>
              <span class="hidden lg:inline">{item.answer}</span>
            </>
          ) : (
            item.answer
          )}
        </p>
      </details>
    ))
  }
</div>
