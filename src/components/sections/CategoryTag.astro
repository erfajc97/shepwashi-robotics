---
// "Chip" de categoría del Figma: punto dorado + texto mono en mayúsculas.
interface Props {
  label: string;
  /** surface = chip del tema · white = blanco fijo sobre fotos · outline = contorno */
  tone?: 'surface' | 'white' | 'outline';
  class?: string;
}
const { label, tone = 'surface', class: className } = Astro.props;
const tones = {
  surface: 'bg-surface text-ink',
  white: 'bg-white text-navy',
  outline: 'border border-ink text-ink',
};
---

<span
  class:list={[
    'inline-flex items-center gap-2 rounded-pill py-2 pr-3.5 pl-3 font-mono text-[11.5px] leading-[1.2] font-medium tracking-[0.92px] whitespace-nowrap uppercase',
    tones[tone],
    className,
  ]}
>
  <span class="size-1.5 rounded-pill bg-gold"></span>
  {label}
</span>
