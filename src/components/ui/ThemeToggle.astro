---
// Alterna data-theme dark/light en <html> y lo guarda en localStorage (lo lee BaseLayout al cargar).
interface Props { class?: string }
const { class: className } = Astro.props;
---

<button type="button" data-theme-toggle aria-label="Cambiar a tema claro" title="Cambiar tema" class:list={['grid size-9 shrink-0 place-items-center rounded-pill transition-colors', className]}>
  <!-- luna: visible en tema oscuro (pulsar = pasar a claro) -->
  <svg data-icon-dark width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
    <path d="M16.5 11.6A6.8 6.8 0 0 1 8.4 3.5a6.8 6.8 0 1 0 8.1 8.1Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <!-- sol: visible en tema claro -->
  <svg data-icon-light width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true" class="hidden">
    <circle cx="10" cy="10" r="3.4" stroke="currentColor" stroke-width="1.6" />
    <path d="M10 2.5v1.8M10 15.7v1.8M2.5 10h1.8M15.7 10h1.8M4.7 4.7l1.3 1.3M14 14l1.3 1.3M15.3 4.7 14 6M6 14l-1.3 1.3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
  </svg>
</button>

<script>
  const root = document.documentElement;
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  const current = () => (root.getAttribute('data-theme') === 'light' ? 'light' : 'dark');

  function paint() {
    const light = current() === 'light';
    buttons.forEach((b) => {
      b.setAttribute('aria-label', light ? 'Cambiar a tema oscuro' : 'Cambiar a tema claro');
      b.querySelector('[data-icon-dark]')?.classList.toggle('hidden', light);
      b.querySelector('[data-icon-light]')?.classList.toggle('hidden', !light);
    });
  }

  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const next = current() === 'light' ? 'dark' : 'light';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('theme', next); } catch {}
      paint();
    }),
  );
  paint();
</script>
