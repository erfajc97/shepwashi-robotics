---
// Icono del sistema de diseño Figma (Icon/*). Inlinea el SVG descargado con color = currentColor.
const files = import.meta.glob('/public/assets/icons/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;

interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 20, class: className } = Astro.props;
const raw = files[`/public/assets/icons/${name}.svg`];
if (!raw) throw new Error(`Icon "${name}" no existe en public/assets/icons`);
const svg = raw
  .replace(/stroke="#[0-9a-fA-F]{3,8}"/g, 'stroke="currentColor"')
  .replace(/fill="#[0-9a-fA-F]{3,8}"/g, 'fill="currentColor"')
  .replace(/width="\d+" height="\d+"/, `width="${size}" height="${size}"`)
  .replace(/style="[^"]*"/, '');
---

<span class:list={['inline-flex shrink-0', className]} style={`width:${size}px;height:${size}px`} aria-hidden="true" set:html={svg} />
