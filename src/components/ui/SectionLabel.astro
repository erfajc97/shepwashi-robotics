---
// "Section Label": cuadrado dorado + texto mono en mayúsculas.
interface Props { label: string; class?: string }
const { label, class: className } = Astro.props;
---
<div class:list={['flex items-center gap-2.5', className]}>
  <span class="size-2 bg-gold"></span>
  <span class="font-mono text-[11.5px] leading-[1.2] font-medium tracking-[0.92px] text-ink uppercase">{label}</span>
</div>
