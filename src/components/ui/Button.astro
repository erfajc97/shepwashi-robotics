---
import Icon from './Icon.astro';

// Tipos del Figma: Primary | Secondary | OnDark | Gold. Pastilla con círculo-flecha a la derecha.
interface Props {
  label: string;
  href?: string;
  variant?: 'primary' | 'secondary' | 'on-dark' | 'gold';
  icon?: string | false;
  class?: string;
}
const { label, href = '#', variant = 'primary', icon = 'arrow-up-right', class: className } = Astro.props;

const shell: Record<string, string> = {
  primary: 'bg-navy text-white',
  secondary: 'border border-ink text-ink',
  'on-dark': 'border border-line-dark text-white',
  gold: 'bg-gold text-on-gold',
};
const arrow: Record<string, string> = {
  primary: 'bg-gold text-on-gold',
  secondary: 'bg-ink text-canvas',
  'on-dark': 'bg-white text-navy',
  gold: 'bg-on-gold text-white',
};
---

<a
  href={href}
  class:list={[
    'inline-flex items-center gap-4 rounded-pill py-1.5 pr-1.5 pl-[22px] text-[15px] leading-[1.2] font-medium tracking-[-0.03px] whitespace-nowrap transition-opacity hover:opacity-90',
    shell[variant],
    className,
  ]}
>
  {label}
  {icon && (
    <span class:list={['grid size-9 place-items-center rounded-pill', arrow[variant]]}>
      <Icon name={icon} size={16} />
    </span>
  )}
</a>
