---
interface Props { label: string; tone?: 'light' | 'outline' | 'dark'; class?: string }
const { label, tone = 'light', class: className } = Astro.props;
const tones = {
  light: 'bg-surface-2 text-ink',
  outline: 'border border-line text-ink',
  dark: 'bg-navy text-white',
};
---
<span class:list={['inline-flex items-center rounded-pill px-4 py-2.5 text-[14px] leading-[1.2]', tones[tone], className]}>{label}</span>
