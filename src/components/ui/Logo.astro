---
// Logo/On dark: wordmark Shepwashi + divisor + "ROBOTICS" en mono dorado.
interface Props { small?: boolean; class?: string }
const { small = false, class: className } = Astro.props;
---
<a href="/" aria-label="Shepwashi Robotics" class:list={['flex items-center', small ? 'gap-[10px]' : 'gap-3', className]}>
  <img src="/assets/brand/shepwashi-logo.png" alt="Shepwashi" class:list={['object-contain', small ? 'h-[17px] w-[99px]' : 'h-[21px] w-[121px]']} />
  <span class:list={['w-px bg-line-dark', small ? 'h-[13px]' : 'h-4']}></span>
  <span class:list={['font-mono font-medium text-gold-soft uppercase', small ? 'text-[9.43px] tracking-[2.07px]' : 'text-[11.5px] tracking-[2.53px]']}>Robotics</span>
</a>
