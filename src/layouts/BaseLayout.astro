---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const { title = 'Shepwashi Robotics', description = 'Robótica de servicio, lista para operar. Recepción, última milla, seguridad, humanoides y médicos en LatAm y el Caribe.' } = Astro.props;
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      try {
        var q = new URLSearchParams(location.search).get('theme');
        if (q === 'light' || q === 'dark') localStorage.setItem('theme', q);
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    </script>
  </head>
  <body class="bg-canvas text-ink">
    <slot />
  </body>
</html>
