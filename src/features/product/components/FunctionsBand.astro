---
import type { ProductDetail } from '@/app/data/productDetails';
import ProductChip from './ProductChip.astro';

interface Props { band: NonNullable<ProductDetail['functionsBand']> }
const { band } = Astro.props;
---

<!-- Móvil: solo chips sueltos (sin tarjeta ni etiqueta). Escritorio: tarjeta con etiqueta "Funciones". -->
<section class="flex flex-col gap-4 px-1 py-2 md:flex-row md:items-center md:gap-6 md:rounded-xl md:bg-surface md:px-8 md:py-5">
  <p class="hidden font-mono text-[11.5px] leading-[1.2] font-medium tracking-[0.92px] whitespace-nowrap text-muted uppercase md:block">{band.label ?? 'Funciones'}</p>
  <ul class="flex min-w-0 flex-1 flex-wrap gap-1.5 md:gap-2">
    {band.items.map((i) => <li><ProductChip label={i} tone="responsive" /></li>)}
  </ul>
</section>
