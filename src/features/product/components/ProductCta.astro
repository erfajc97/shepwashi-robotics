---
import type { ProductDetail } from '@/app/data/productDetails';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';

interface Props { data: ProductDetail['cta'] }
const { data } = Astro.props;
const mobileDesc = data.mobileDescription ?? data.description;
---

<!-- Móvil: bloque panel con botones apilados. Escritorio: bloque claro (ink) con título oscuro. -->
<section class="flex flex-col gap-4 rounded-lg bg-panel px-5 pt-8 pb-5 md:flex-row md:items-center md:justify-between md:gap-8 md:rounded-xl md:bg-ink md:py-12 md:pr-8 md:pl-14">
  <div class="flex flex-col gap-3">
    <h2 class="text-[28px] leading-[1.1] font-medium tracking-[-0.56px] text-white md:text-[40px] md:leading-[1.08] md:tracking-[-1px] md:text-inverse">{data.title}</h2>
    {mobileDesc && <p class="text-[14px] leading-[1.5] text-on-dark-muted md:hidden">{mobileDesc}</p>}
    {data.description && <p class="hidden text-[16px] leading-[1.55] tracking-[-0.032px] text-on-dark-muted md:block">{data.description}</p>}
  </div>
  <div class="flex shrink-0 flex-col gap-4 md:flex-row md:gap-3">
    <Button label={data.primary.label} href={data.primary.href} variant="gold" class="justify-between md:justify-start" />
    {data.secondary && (
      <a href={data.secondary.href} class="inline-flex items-center justify-between gap-4 rounded-pill bg-white py-1.5 pr-1.5 pl-[22px] text-[15px] leading-[1.2] font-medium tracking-[-0.03px] whitespace-nowrap text-navy transition-opacity hover:opacity-90 md:justify-start md:bg-inverse md:text-ink">
        {data.secondary.label}
        <span class="grid size-9 place-items-center rounded-pill bg-navy text-white md:bg-ink md:text-inverse"><Icon name="arrow-up-right" size={16} /></span>
      </a>
    )}
  </div>
</section>
