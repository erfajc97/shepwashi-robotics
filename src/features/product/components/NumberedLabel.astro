---
// Etiqueta de sección numerada: cuadrado dorado + "01" + regla + título (mono, mayúsculas).
// `mobileLabel`: texto distinto en móvil (< md).
interface Props { number: string; label: string; mobileLabel?: string; class?: string }
const { number, label, mobileLabel, class: className } = Astro.props;
const text = 'font-mono text-[11.5px] leading-[1.2] font-medium tracking-[0.92px] text-ink uppercase';
---
<div class:list={['flex items-center gap-2.5', className]}>
  <span class="size-2 bg-gold"></span>
  <span class="font-mono text-[11.5px] leading-[1.2] font-medium tracking-[0.92px] text-muted uppercase">{number}</span>
  <span class="h-px w-6 bg-subtle"></span>
  {mobileLabel && mobileLabel !== label ? (
    <>
      <span class:list={[text, 'md:hidden']}>{mobileLabel}</span>
      <span class:list={[text, 'hidden md:inline']}>{label}</span>
    </>
  ) : (
    <span class={text}>{label}</span>
  )}
</div>
