---
import type { ProductDetail } from '@/app/data/productDetails';
import Icon from '@/components/ui/Icon.astro';
import NumberedLabel from './NumberedLabel.astro';

interface Props { data: NonNullable<ProductDetail['coreFunctions']>; number: string }
const { data, number } = Astro.props;
const cols = { 2: 'md:grid-cols-2', 3: 'md:grid-cols-2 lg:grid-cols-3', 4: 'md:grid-cols-2 lg:grid-cols-4' }[data.columns ?? 3];
const num = (f: { number?: string }, i: number) => f.number ?? String(i + 1).padStart(2, '0');
---

<section class="flex flex-col gap-5 rounded-lg bg-surface px-5 pt-9 pb-5 md:gap-10 md:rounded-xl md:px-12 md:pt-[72px] md:pb-8">
  <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
    <div class="flex flex-col gap-5">
      <NumberedLabel number={number} label={data.label ?? 'Funciones principales'} />
      <h2 class:list={["text-[28px] leading-[1.1] font-medium tracking-[-0.56px] text-ink md:text-[44px] md:leading-[1.02] md:tracking-[-1.31px]", data.title.includes("\n") ? "md:whitespace-pre" : "md:max-w-[820px]"]}>{data.title}</h2>
    </div>
    {data.intro && <p class="text-[14px] leading-[1.5] text-muted md:w-[440px] md:text-[16px] md:leading-[1.55] md:tracking-[-0.032px]">{data.intro}</p>}
  </div>

  <!-- Móvil: lista con número a la izquierda y separadores -->
  <ul class="flex flex-col md:hidden">
    {data.features.map((f, i) => (
      <li class="flex gap-3.5 border-t border-line py-4">
        <span class="w-[15px] shrink-0 pt-[3px] font-mono text-[11.5px] leading-[1.2] font-medium tracking-[0.92px] text-gold uppercase">{num(f, i)}</span>
        <div class="flex min-w-0 flex-col gap-1.5">
          <h3 class="text-[17px] leading-[1.3] font-medium text-ink">{f.title}</h3>
          <p class="text-[14px] leading-[1.5] text-muted">{f.description}</p>
        </div>
      </li>
    ))}
  </ul>

  <!-- Escritorio: tarjetas -->
  <ul class:list={['hidden gap-4 md:grid', cols]}>
    {data.features.map((f, i) => (
      <li class="flex flex-col gap-3.5 rounded-lg bg-surface-2 px-6 pt-6 pb-7">
        <div class="flex items-center justify-between">
          <span class="font-mono text-[11.5px] leading-[1.2] font-medium tracking-[0.92px] text-gold uppercase">{num(f, i)}</span>
          <span class="h-px w-6 bg-subtle"></span>
        </div>
        {f.icon ? <Icon name={f.icon} size={28} class="text-ink" /> : <div class="h-7 w-px"></div>}
        <h3 class="text-[19px] leading-[1.25] font-medium tracking-[-0.21px] text-ink">{f.title}</h3>
        <p class="text-[14px] leading-[1.5] text-muted">{f.description}</p>
      </li>
    ))}
  </ul>
</section>
