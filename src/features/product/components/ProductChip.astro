---
// Chip del diseño: punto dorado + texto mono en mayúsculas.
// tone: outline (borde) · filled (fondo surface) · white (blanco fijo sobre fotos) · responsive (filled en móvil, outline en md+).
interface Props { label: string; tone?: 'outline' | 'filled' | 'white' | 'responsive'; class?: string }
const { label, tone = 'outline', class: className } = Astro.props;
const tones = {
  outline: 'border border-ink text-ink',
  filled: 'bg-surface text-ink',
  white: 'bg-white text-navy',
  responsive: 'bg-surface text-ink md:border md:border-ink md:bg-transparent',
};
---
<span
  class:list={[
    'inline-flex items-center gap-2 rounded-pill py-2 pr-3.5 pl-3 font-mono text-[11.5px] leading-[1.2] font-medium tracking-[0.92px] whitespace-nowrap uppercase',
    tones[tone],
    className,
  ]}
>
  <span class="size-1.5 rounded-pill bg-gold"></span>{label}
</span>
