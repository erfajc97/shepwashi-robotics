---
import type { ProductDetail } from '@/app/data/productDetails';
import Button from '@/components/ui/Button.astro';
import NumberedLabel from './NumberedLabel.astro';

interface Props { data: NonNullable<ProductDetail['specs']>; number: string }
const { data, number } = Astro.props;
const gridCols = data.columns === 2 ? 'sm:grid-cols-2' : 'sm:grid-cols-2 lg:grid-cols-3';
// Layout 'matrix': columns = nombres de columna (p. ej. F150/F300/F600); cada fila trae `values` (una por columna,
// o una sola que ocupa todas las columnas). En móvil se apilan como "F150: valor".
const isMatrix = data.layout === 'matrix';
const cols: string[] = Array.isArray(data.columns) ? data.columns : [];
const matrixRows = data.rows.map((r) => {
  const values = r.values ?? (r.value !== undefined ? [r.value] : []);
  const mobile = values.length > 1 && values.length === cols.length ? values.map((v, i) => `${cols[i]}: ${v}`) : values;
  return { label: r.label, values, mobile, span: values.length === cols.length ? 1 : cols.length };
});
---

<section class="flex flex-col gap-5 rounded-lg bg-surface px-5 pt-9 pb-5 md:flex-row md:gap-16 md:rounded-xl md:px-12 md:pt-[72px] md:pb-14">
  <div class="flex flex-col items-start gap-5 md:w-[340px] md:shrink-0 md:gap-6">
    <NumberedLabel number={number} label={data.label ?? 'Especificaciones'} />
    <h2 class="text-[28px] leading-[1.1] font-medium tracking-[-0.56px] text-ink md:text-[56px] md:leading-[1.02] md:tracking-[-1.68px]">{data.title}</h2>
    {data.note && <p class="hidden text-[16px] leading-[1.55] tracking-[-0.032px] text-muted md:block">{data.note}</p>}
    {data.pdf && <Button label={data.pdf.label} href={data.pdf.href} variant="secondary" class="max-md:hidden" />}
  </div>
  {isMatrix ? (
    <div class="min-w-0 flex-1 self-stretch md:self-start">
      <!-- Escritorio: cabecera de modelos + filas con una columna por modelo -->
      <div class="hidden md:block">
        <div class="grid items-center py-3.5" style={`grid-template-columns: 1fr repeat(${cols.length}, 170px)`}>
          <span class="font-mono text-[11.5px] leading-[1.2] font-medium tracking-[0.92px] text-muted uppercase">{data.matrixLabel ?? 'Modelo'}</span>
          {cols.map((c) => <span class="font-mono text-[11.5px] leading-[1.2] font-medium tracking-[0.92px] text-ink uppercase">{c}</span>)}
        </div>
        {matrixRows.map((r) => (
          <div class="grid items-center border-t border-line py-4 last:border-b" style={`grid-template-columns: 1fr repeat(${cols.length}, 170px)`}>
            <span class="text-[16px] leading-[1.55] tracking-[-0.032px] text-muted">{r.label}</span>
            {r.values.map((v) => (
              <span class="font-mono text-[14px] leading-[1.35] font-normal text-ink" style={r.span > 1 ? `grid-column: span ${r.span}` : undefined}>{v}</span>
            ))}
          </div>
        ))}
      </div>
      <!-- Móvil: etiqueta + valores apilados -->
      <dl class="flex flex-col border-b border-line md:hidden">
        {matrixRows.map((r) => (
          <div class="flex items-start gap-3 border-t border-line py-3">
            <dt class="min-w-0 flex-1 text-[14px] leading-[1.5] text-muted">{r.label}</dt>
            <dd class="flex max-w-[56%] flex-col text-right font-mono text-[12.5px] leading-[1.35] font-normal text-ink">{r.mobile.map((l) => <span>{l}</span>)}</dd>
          </div>
        ))}
      </dl>
    </div>
  ) : (data.layout ?? 'table') === 'table' ? (
    <dl class="flex min-w-0 flex-1 flex-col self-stretch border-b border-line md:self-start">
      {data.rows.map((r) => (
        <div class="flex items-center gap-3 border-t border-line py-3 md:gap-6 md:py-4">
          <dt class="min-w-0 flex-1 text-[14px] leading-[1.5] text-muted md:text-[16px] md:leading-[1.55] md:tracking-[-0.032px]">{r.label}</dt>
          <dd class="text-right font-mono font-normal text-[12.5px] leading-[1.35] text-ink md:text-[14px] md:whitespace-nowrap">{r.value}</dd>
        </div>
      ))}
    </dl>
  ) : (
    <dl class:list={['grid min-w-0 flex-1 gap-4 self-start', gridCols]}>
      {data.rows.map((r) => (
        <div class="flex flex-col gap-3 rounded-md bg-surface-2 p-5">
          <dt class="text-[14px] leading-[1.5] text-muted">{r.label}</dt>
          <dd class="font-mono font-normal text-[18px] leading-[1.35] text-ink">{r.value}</dd>
        </div>
      ))}
    </dl>
  )}
  {data.pdf && <Button label={data.pdf.label} href={data.pdf.href} variant="secondary" class="w-full justify-between md:hidden" />}
</section>
