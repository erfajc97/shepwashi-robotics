---
import ThemedImg from '@/components/ui/ThemedImg.astro';
import Icon from '@/components/ui/Icon.astro';
import { categoryLabel, type Product } from '@/app/data/products';

// "Product Card" del Figma (1:300). Toda la tarjeta enlaza a /producto/<slug>.
interface Props { product: Product; class?: string }
const { product, class: className } = Astro.props;
---

<a href={product.href} class:list={['group flex flex-col rounded-lg bg-surface px-2 pt-2 pb-5', className]}>
  <div class="relative flex h-[min(340px,21svh)] flex-col items-start overflow-hidden rounded-md bg-stage pt-3 pl-3">
    <ThemedImg src={product.imagen} alt={product.nombre} loading="lazy" class="absolute inset-0 size-full object-contain" />
    <span class="relative inline-flex items-center gap-2 rounded-pill bg-surface py-2 pr-3.5 pl-3 font-mono text-[11.5px] leading-[1.2] font-medium tracking-[0.92px] text-ink uppercase">
      <span class="size-1.5 rounded-pill bg-gold"></span>{categoryLabel(product.categoria)}
    </span>
  </div>
  <div class="flex items-center justify-between gap-3 pt-[18px] pr-2 pl-3">
    <div class="flex min-w-0 flex-1 flex-col gap-1">
      <p class="text-[19px] leading-tight font-medium tracking-[-0.21px] text-ink">{product.nombre}</p>
      <p class="text-[14px] leading-normal text-muted">{product.tagline}</p>
    </div>
    <span class="grid size-11 shrink-0 place-items-center rounded-pill border border-ink text-ink transition-colors group-hover:bg-gold group-hover:border-gold group-hover:text-on-gold">
      <Icon name="arrow-right" size={18} />
    </span>
  </div>
</a>
