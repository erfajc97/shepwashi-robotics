---
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import type { SolutionData } from '@/app/data/solutions';

// Móvil: tarjeta panel con título y dos botones apilados (botón blanco). Escritorio: banda "ink" (clara en
// oscuro, oscura en claro) con título + subtítulo a la izquierda y los botones a la derecha.
interface Props { data: SolutionData['cta'] }
const { data } = Astro.props;
---

<section class="flex flex-col gap-4 rounded-lg bg-panel px-5 pt-8 pb-5 md:flex-row md:items-center md:justify-between md:gap-0 md:rounded-xl md:bg-ink md:py-12 md:pr-8 md:pl-14">
  <div class="flex flex-col gap-3 md:w-[640px]">
    <h2 class="text-[28px] leading-[1.1] font-medium tracking-[-0.56px] text-white md:text-[32px] md:leading-[1.08] md:tracking-[-1px] md:text-inverse">{data.title}</h2>
    {data.subtitle && <p class="hidden text-[16px] leading-[25px] tracking-[-0.032px] text-on-dark-muted md:block">{data.subtitle}</p>}
  </div>
  <div class="flex flex-col gap-4 md:flex-row md:gap-3">
    <Button label={data.primary.label} href={data.primary.href} variant="gold" class="w-full justify-between md:w-auto md:justify-start" />
    <a href={data.secondary.href} class="inline-flex w-full items-center justify-between gap-4 rounded-pill bg-white py-1.5 pr-1.5 pl-[22px] text-[15px] leading-[1.2] font-medium tracking-[-0.03px] whitespace-nowrap text-navy transition-opacity hover:opacity-90 md:w-auto md:justify-start md:bg-inverse md:text-ink">
      {data.secondary.label}
      <span class="grid size-9 place-items-center rounded-pill bg-navy text-white md:bg-ink md:text-inverse"><Icon name="arrow-up-right" size={16} /></span>
    </a>
  </div>
</section>
