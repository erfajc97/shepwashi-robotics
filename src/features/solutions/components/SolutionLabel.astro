---
// Section Label numerado de las páginas de solución: cuadrado dorado + "01" + línea + texto mono.
interface Props { index: string; label: string; tone?: 'light' | 'dark'; class?: string }
const { index, label, tone = 'light', class: className } = Astro.props;
---

<div class:list={['flex items-center gap-2.5', className]}>
  <span class="size-2 bg-gold"></span>
  <span class:list={['font-mono text-[11.5px] leading-[1.2] font-medium tracking-[0.92px] uppercase', tone === 'light' ? 'text-muted' : 'text-on-dark-muted']}>{index}</span>
  <span class="h-px w-6 bg-subtle"></span>
  <span class:list={['font-mono text-[11.5px] leading-[1.2] font-medium tracking-[0.92px] whitespace-nowrap uppercase', tone === 'light' ? 'text-ink' : 'text-white']}>{label}</span>
</div>
