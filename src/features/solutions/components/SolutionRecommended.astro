---
import Button from '@/components/ui/Button.astro';
import SolutionLabel from './SolutionLabel.astro';
import SolutionProductCard from './SolutionProductCard.astro';
import { products } from '@/app/data/products';
import { solutionMobileLimits, type SolutionData } from '@/app/data/solutions';

interface Props { data: SolutionData['recommended']; label: string }
const { data, label } = Astro.props;
const items = data.products.map((ref) => {
  const o = typeof ref === 'string' ? { slug: ref } : ref;
  const p = products.find((x) => x.slug === o.slug);
  if (!p) throw new Error(`Producto "${o.slug}" no existe en src/app/data/products.ts`);
  return { ...p, nombre: o.nombre ?? p.nombre, tagline: o.tagline ?? p.tagline, href: o.href ?? p.href };
});
---

<section id="robots" class="flex scroll-mt-4 flex-col gap-4 pt-7 pb-2 pl-1 md:gap-8 md:px-8 md:pt-14 md:pb-6">
  <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
    <div class="flex flex-col gap-4 md:max-w-[900px] md:gap-5">
      <SolutionLabel index="04" label={label} />
      <h2 class="text-[28px] leading-[1.1] font-medium tracking-[-0.56px] text-ink md:text-[56px] md:leading-[1.02] md:tracking-[-1.68px]">{data.title}</h2>
    </div>
    <div class="hidden md:block"><Button label={data.cta.label} href={data.cta.href} variant="secondary" /></div>
  </div>
  <div class="-mr-4 flex snap-x gap-2.5 overflow-x-auto pr-4 md:mr-0 md:grid md:grid-cols-4 md:items-start md:gap-4 md:overflow-visible md:pr-0">
    {items.map((p, i) => (
      <SolutionProductCard product={p} class:list={['w-[240px] shrink-0 snap-start md:w-auto', i >= solutionMobileLimits.products && 'hidden md:flex']} />
    ))}
  </div>
</section>
