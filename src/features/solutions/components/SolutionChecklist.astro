---
import Icon from '@/components/ui/Icon.astro';
import SolutionLabel from './SolutionLabel.astro';

// Tarjeta de lista: variant "challenges" (fondo surface, iconos x) o "why" (fondo panel, iconos check dorados).
interface Props {
  variant: 'challenges' | 'why';
  index: string;
  label: string;
  title: string;
  items: string[];
  /** elementos visibles en móvil; el resto solo desde md */
  mobileLimit: number;
}
const { variant, index, label, title, items, mobileLimit } = Astro.props;
const isWhy = variant === 'why';
---

<section class:list={['flex flex-col gap-4 rounded-lg px-5 pt-9 pb-5 md:gap-7 md:rounded-xl md:px-12 md:pt-16 md:pb-12', isWhy ? 'bg-panel' : 'bg-surface']}>
  <SolutionLabel index={index} label={label} tone={isWhy ? 'dark' : 'light'} />
  <h2 class:list={['text-[28px] leading-[1.1] font-medium tracking-[-0.56px] md:text-[40px] md:leading-[1.08] md:tracking-[-1px]', isWhy ? 'text-white' : 'text-ink']}>{title}</h2>
  <ul class="flex flex-col">
    {items.map((text, i) => (
      <li class:list={['gap-3.5 border-t py-3.5', isWhy ? 'border-line-dark' : 'border-line', i < mobileLimit ? 'flex' : 'hidden md:flex']}>
        <span class:list={['grid size-6 shrink-0 place-items-center rounded-pill', isWhy ? 'bg-gold text-on-gold' : 'bg-muted text-white']}>
          <Icon name={isWhy ? 'check' : 'x'} size={14} />
        </span>
        <p class:list={['min-w-0 flex-1 text-[14px] leading-normal md:text-[16px] md:leading-[25px] md:tracking-[-0.032px]', isWhy ? 'text-white' : 'text-ink-2']}>{text}</p>
      </li>
    ))}
  </ul>
</section>
