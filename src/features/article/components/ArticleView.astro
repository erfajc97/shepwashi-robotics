---
import IndexedLabel from '@/features/resources/components/IndexedLabel.astro';
import PostCard from '@/features/resources/components/PostCard.astro';
import { relatedArticles, type Article } from '@/app/data/articles';

interface Props { article: Article }
const { article } = Astro.props;

const slugify = (s: string) =>
  s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const headings = article.body.filter((b) => b.type === 'h').map((b) => ({ text: (b as { text: string }).text, id: slugify((b as { text: string }).text) }));
const related = relatedArticles(article);

const mono = 'font-mono text-[11.5px] leading-[1.2] font-medium tracking-[0.92px] uppercase';
const shareChip = `inline-flex items-center gap-2 rounded-pill border border-ink py-2 pr-3.5 pl-3 text-ink ${mono}`;
---
<div class="flex flex-col gap-3 md:gap-4">
  <header class="flex flex-col gap-4 px-1 pt-7 pb-2 md:items-center md:gap-7 md:px-[200px] md:pt-[72px] md:pb-10">
    <p class:list={[mono, 'whitespace-pre text-muted']}>
      <a href="/recursos" class="hover:text-ink">Recursos</a>{'  /  '}{article.category}
    </p>
    <h1 class="text-[36px] leading-[1.05] font-medium tracking-[-3px] text-ink md:text-center md:text-[72px] md:leading-[0.98] md:tracking-[-4px]">{article.title}</h1>
    <div class:list={[mono, 'items-center gap-4 whitespace-pre text-muted']}>
      <span class="hidden items-center gap-2 rounded-pill border border-ink py-2 pr-3.5 pl-3 text-ink md:inline-flex">
        <span class="size-1.5 rounded-full bg-gold"></span>{article.category}
      </span>
      <span class="md:hidden">{article.date}  ·  {article.minutes} min</span>
      <span class="hidden md:inline">{article.date}  ·  {article.minutes} min de lectura  ·  {article.author}</span>
    </div>
  </header>

  <div class="h-[260px] overflow-hidden rounded-lg bg-surface md:h-[640px] md:rounded-xl">
    <img src={article.image} alt={article.title} class="size-full object-cover" />
  </div>

  <div class="flex gap-16 rounded-lg bg-surface px-5 pt-8 pb-7 md:rounded-xl md:px-[120px] md:pt-[72px] md:pb-[72px]">
    <aside class="hidden shrink-0 md:block" aria-label="En este artículo">
      <nav class="sticky top-24 flex flex-col gap-3.5">
        <p class:list={[mono, 'text-muted']}>En este artículo</p>
        <ul class="flex flex-col gap-3.5">
          {headings.map((h, i) => (
            <li>
              <a href={`#${h.id}`} data-toc class:list={['block pl-3 text-[14px] leading-[1.5]', i === 0 ? 'text-ink' : 'text-muted hover:text-ink']}>{h.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>

    <article class="flex w-full min-w-0 flex-col gap-[18px] md:w-[760px] md:flex-none md:gap-6">
      <p class="text-[21px] leading-[1.2] font-medium tracking-[-1px] text-ink md:hidden">{article.mobileLead ?? article.lead}</p>
      <p class="hidden text-[19px] leading-[1.5] tracking-[-0.5px] text-ink md:block">{article.lead}</p>

      {article.body.map((b) => {
        if (b.type === 'h') {
          return <h2 id={slugify(b.text)} class:list={['scroll-mt-24 text-[17px] leading-[1.3] font-medium tracking-[-0.5px] text-ink md:text-[28px] md:leading-[1.15] md:tracking-[-1.5px]', b.hideOnMobile && 'hidden md:block']}>{b.text}</h2>;
        }
        if (b.type === 'p') {
          return (
            <>
              {b.mobileText !== null && <p class="text-[15px] leading-[1.55] tracking-[-0.2px] text-ink-2 md:hidden">{b.mobileText ?? b.text}</p>}
              <p class:list={['text-[16px] leading-[1.55] tracking-[-0.2px] text-ink-2', b.mobileText === null ? '' : 'hidden md:block']}>{b.text}</p>
            </>
          );
        }
        if (b.type === 'quote') {
          return (
            <blockquote class="border-l-[3px] border-gold py-0 pl-[18px] md:py-2 md:pl-7">
              <p class="text-[21px] leading-[1.2] font-medium tracking-[-1px] text-ink md:hidden">{b.mobileText ?? b.text}</p>
              <p class="hidden text-[21px] leading-[1.25] font-medium tracking-[-1px] text-ink md:block">{b.text}</p>
            </blockquote>
          );
        }
        return <div class="hidden h-[420px] overflow-hidden rounded-lg md:block"><img src={b.src} alt={b.alt} loading="lazy" class="size-full object-cover" /></div>;
      })}

      <div class="hidden items-center gap-3 border-t border-line pt-6 md:flex">
        <span class:list={[mono, 'text-muted']}>Compartir</span>
        <a class={shareChip} href={`https://www.linkedin.com/sharing/share-offsite/?url=`} data-share="linkedin" target="_blank" rel="noopener"><span class="size-1.5 rounded-full bg-gold"></span>LinkedIn</a>
        <a class={shareChip} href={`https://wa.me/?text=`} data-share="whatsapp" target="_blank" rel="noopener"><span class="size-1.5 rounded-full bg-gold"></span>WhatsApp</a>
        <button type="button" id="copy-link" class={shareChip}><span class="size-1.5 rounded-full bg-gold"></span>Copiar enlace</button>
      </div>
    </article>
  </div>

  <section class="hidden flex-col gap-8 px-8 pt-14 pb-6 md:flex" aria-label="Artículos relacionados">
    <div class="flex flex-col gap-5">
      <IndexedLabel index="→" label="Sigue leyendo" />
      <h2 class="text-[56px] leading-[1.02] font-medium tracking-[-3px] text-ink">Artículos relacionados</h2>
    </div>
    <div class="grid grid-cols-3 gap-6">
      {related.map((a) => <PostCard article={a} />)}
    </div>
  </section>
</div>

<script>
  const url = () => encodeURIComponent(location.href);
  document.querySelectorAll<HTMLAnchorElement>('[data-share]').forEach((a) => {
    a.addEventListener('click', () => {
      a.href = a.dataset.share === 'linkedin'
        ? `https://www.linkedin.com/sharing/share-offsite/?url=${url()}`
        : `https://wa.me/?text=${url()}`;
    });
  });
  const copy = document.getElementById('copy-link');
  copy?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(location.href);
      const prev = copy.lastChild!.textContent;
      copy.lastChild!.textContent = '¡Copiado!';
      setTimeout(() => (copy.lastChild!.textContent = prev), 1500);
    } catch {}
  });
  // Resalta en el índice la sección visible.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc]'));
  const heads = links.map((l) => document.getElementById(l.hash.slice(1))).filter(Boolean) as HTMLElement[];
  if (heads.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          links.forEach((l) => {
            const on = l.hash === `#${e.target.id}`;
            l.classList.toggle('text-ink', on);
            l.classList.toggle('text-muted', !on);
          });
        });
      },
      { rootMargin: '-20% 0px -70% 0px' },
    );
    heads.forEach((h) => io.observe(h));
  }
</script>
