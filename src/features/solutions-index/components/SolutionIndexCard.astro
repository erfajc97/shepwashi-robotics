---
import Icon from '@/components/ui/Icon.astro';
import type { SolutionIndexItem } from '@/app/data/solutionsIndex';

interface Props { item: SolutionIndexItem; index: number }
const { item, index } = Astro.props;
const large = index < 2 || index > 7;
const wide = index < 2 || index > 7; // filas de 2 columnas (696 px) en escritorio
const tall = index < 2; // 560 px de alto
const number = String(index + 1).padStart(2, '0');
---

<a
  href={`/soluciones/${item.slug}`}
  class:list={[
    'group relative isolate block h-[min(300px,19svh)] overflow-hidden rounded-lg bg-surface md:rounded-xl',
    wide ? 'md:col-span-3' : 'md:col-span-2',
    tall ? 'md:h-[min(560px,35svh)]' : 'md:h-[min(440px,28svh)]',
  ]}
  aria-label={`${item.name}: ${item.tagline}`}
>
  <img src={item.image} alt="" loading="lazy" class="absolute inset-0 -z-20 size-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
  <span class="absolute inset-0 -z-10 bg-gradient-to-b from-[#050f1f]/30 to-[#050f1f]/90"></span>
  <span class="absolute top-[18px] left-[18px] font-mono text-[11.5px] leading-[1.2] font-medium tracking-[0.92px] text-white uppercase md:top-6 md:left-6">{number}</span>
  <div class="absolute bottom-[18px] left-[18px] flex w-[280px] max-w-[calc(100%-36px)] flex-col gap-1.5 text-white md:bottom-6 md:left-6 md:w-auto md:max-w-[calc(100%-48px)] md:gap-2.5">
    <h2 class:list={['text-[28px] leading-[1.1] font-medium tracking-[-1.56px]', large ? 'md:text-[44px] md:leading-[1.02] md:tracking-[-2.34px]' : 'md:text-[32px] md:leading-[1.08] md:tracking-[-1.95px]']}>{item.name}</h2>
    <p class:list={['text-[14px] leading-normal opacity-80 md:text-[16px] md:leading-[1.55] md:tracking-[-0.2px]', large ? 'md:max-w-[556px]' : 'md:max-w-[318px]']}>{item.tagline}</p>
    <p class="flex items-baseline gap-2 md:pt-1.5">
      <span class="font-mono text-[14px] leading-[1.35] text-gold-soft">{item.statValue}</span>
      <span class="text-[14px] leading-normal opacity-70">{item.statLabel}</span>
    </p>
  </div>
  <span class="absolute right-6 bottom-6 hidden size-11 place-items-center rounded-pill border border-white/30 bg-white/15 text-white backdrop-blur-[12px] transition-colors group-hover:bg-white/25 md:grid">
    <Icon name="arrow-right" size={16} />
  </span>
</a>
