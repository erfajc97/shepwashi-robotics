---
// "Section Label" con índice: cuadrado dorado + índice + regla + texto (Nosotros, Destacado, Sigue leyendo).
interface Props { index: string; label: string; tone?: 'default' | 'on-dark'; class?: string }
const { index, label, tone = 'default', class: className } = Astro.props;
const dark = tone === 'on-dark';
---
<div class:list={['flex items-center gap-2.5 font-mono text-[11.5px] leading-[1.2] font-medium tracking-[0.92px] uppercase', className]}>
  <span class="size-2 shrink-0 bg-gold"></span>
  <span class={dark ? 'text-on-dark-muted' : 'text-muted'}>{index}</span>
  <span class:list={['h-px w-6', dark ? 'bg-on-dark-muted' : 'bg-subtle']}></span>
  <span class={dark ? 'text-white' : 'text-ink'}>{label}</span>
</div>
