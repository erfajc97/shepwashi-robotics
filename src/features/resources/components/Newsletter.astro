---
import Icon from '@/components/ui/Icon.astro';
---
<section class="hidden items-center justify-between rounded-xl bg-ink py-12 pr-8 pl-14 md:flex">
  <div class="flex flex-col gap-3">
    <h2 class="text-[32px] leading-[1.08] font-medium tracking-[-1.95px] text-inverse">Recibe una guía práctica al mes.</h2>
    <p class="text-[16px] leading-[1.55] tracking-[-0.2px] text-on-dark-muted">Casos, especificaciones y novedades de robótica de servicio.</p>
  </div>
  <form class="flex h-[60px] w-[460px] items-center justify-between rounded-pill bg-navy-3 py-1.5 pr-1.5 pl-[22px]" onsubmit="return false">
    <input type="email" required placeholder="Tu correo corporativo" aria-label="Tu correo corporativo" class="min-w-0 flex-1 bg-transparent text-[16px] leading-[1.55] tracking-[-0.2px] text-white outline-none placeholder:text-on-dark-muted" />
    <button type="submit" class="inline-flex items-center gap-4 rounded-pill bg-gold py-1.5 pr-1.5 pl-[22px] text-[15px] leading-[1.2] font-medium tracking-[-0.2px] whitespace-nowrap text-on-gold transition-opacity hover:opacity-90">
      Suscribirme
      <span class="grid size-9 place-items-center rounded-pill bg-on-gold text-white"><Icon name="arrow-up-right" size={16} /></span>
    </button>
  </form>
</section>
