---
import Button from '@/components/ui/Button.astro';
import IndexedLabel from './IndexedLabel.astro';
import type { Article } from '@/app/data/articles';

interface Props { article: Article }
const { article } = Astro.props;
---
<section class="hidden overflow-hidden rounded-xl bg-surface md:flex md:h-[520px]" aria-label="Artículo destacado">
  <div class="w-[840px] shrink-0 overflow-hidden">
    <img src={article.image} alt={article.title} class="size-full object-cover" />
  </div>
  <div class="flex min-w-0 flex-1 flex-col justify-between gap-5 p-12">
    <div class="flex flex-col gap-5">
      <IndexedLabel index="★" label="Destacado" />
      <h2 class="text-[40px] leading-[1.08] font-medium tracking-[-2.5px] text-ink">{article.title}</h2>
      <p class="text-[16px] leading-[1.55] tracking-[-0.2px] text-muted">{article.summary}</p>
    </div>
    <div class="flex items-center justify-between">
      <p class="font-mono text-[11.5px] leading-[1.2] font-medium tracking-[0.92px] whitespace-pre text-muted uppercase">{article.date}  ·  {article.minutes} min</p>
      <Button label="Leer artículo" href={`/recursos/${article.slug}`} variant="gold" />
    </div>
  </div>
</section>
