---
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import IndexedLabel from '@/features/resources/components/IndexedLabel.astro';
import Glyph from './Glyph.astro';
import { whatWeDo, manufacturerStats, certifications, technologies, offices } from '@/app/data/about';

const mono = 'font-mono text-[11.5px] leading-[1.2] font-medium tracking-[0.92px] uppercase';
const h2 = 'text-[28px] leading-[1.1] font-medium tracking-[-1.56px] md:text-[44px] md:leading-[1.02] md:tracking-[-2.34px]';
---
<!-- Hero -->
<header class="flex flex-col gap-4 px-1 pt-7 pb-2 md:gap-6 md:px-8 md:pt-14 md:pb-6">
  <p class:list={[mono, 'whitespace-pre text-muted']}>Inicio  /  Nosotros</p>
  <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between md:gap-0">
    <h1 class="text-[40px] leading-[0.94] font-medium tracking-[-3.12px] text-ink md:text-[72px] md:tracking-[-3.51px]">
      La línea de robótica<br class="hidden md:inline" /> de Shepwashi.
    </h1>
    <p class="text-[15px] leading-[1.55] tracking-[-0.2px] text-ink-2 md:hidden">Firma de software y consultoría en IA en Latinoamérica y el Caribe, ahora con robótica de servicio: seleccionamos, integramos y operamos robots en empresas de la región.</p>
    <p class="hidden w-[440px] pb-1 text-[17px] leading-[1.5] tracking-[-0.5px] text-ink-2 md:block">Shepwashi es una firma de desarrollo de software y consultoría en IA que opera en Latinoamérica y el Caribe. Shepwashi Robotics lleva esa experiencia a la robótica de servicio: seleccionamos, integramos y operamos robots en empresas de la región.</p>
  </div>
</header>

<div class="h-[260px] overflow-hidden rounded-lg md:h-[min(560px,35svh)] md:rounded-xl">
  <img src="/assets/nosotros/hero.jpg" alt="Robots de Shepwashi Robotics en operación" class="size-full object-cover" />
</div>

<!-- 01 Lo que hacemos -->
<section class="flex flex-col gap-4 rounded-lg bg-surface px-5 pt-9 pb-5 md:gap-10 md:rounded-xl md:px-12 md:pt-[72px] md:pb-8" aria-labelledby="que-hacemos">
  <div class="flex flex-col gap-5">
    <IndexedLabel index="01" label="Lo que hacemos" />
    <h2 id="que-hacemos" class:list={[h2, 'text-ink']}>Software, IA y robots,<br class="hidden md:inline" /> en una sola implementación.</h2>
  </div>
  <div class="flex flex-col md:grid md:grid-cols-3 md:items-start md:gap-4">
    {whatWeDo.map((w) => (
      <div class="flex gap-3.5 border-t border-line pt-3.5 pb-1.5 md:flex-col md:gap-4 md:rounded-lg md:border-0 md:bg-surface-2 md:p-7 md:pb-8">
        <Glyph name={w.glyph} class="md:bg-surface-2" />
        <div class="hidden h-6 md:block"></div>
        <div class="flex flex-col gap-1 md:gap-4">
          <h3 class="text-[17px] leading-[1.3] font-medium tracking-[-0.5px] text-ink md:text-[28px] md:leading-[1.15] md:tracking-[-1.17px]">{w.title}</h3>
          <p class="text-[14px] leading-[1.5] text-muted md:text-[16px] md:leading-[1.55] md:tracking-[-0.2px]">{w.text}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<!-- 02 Respaldo de fábrica -->
<section class="flex flex-col gap-4 rounded-lg bg-panel px-5 pt-9 pb-5 md:gap-10 md:rounded-xl md:px-12 md:pt-[72px] md:pb-8" aria-labelledby="respaldo">
  <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
    <div class="flex flex-col gap-5">
      <IndexedLabel index="02" label="Respaldo de fábrica" tone="on-dark" />
      <h2 id="respaldo" class:list={[h2, 'text-white']}>Un fabricante con<br class="hidden md:inline" /> dos décadas de trayectoria.</h2>
    </div>
    <p class="hidden w-[440px] pb-1 text-[16px] leading-[1.55] tracking-[-0.2px] text-on-dark-muted md:block">Nuestros robots provienen de uno de los mayores fabricantes de robots de servicio del mundo, con una base de producción de cerca de 30.000 m² y presencia global.</p>
  </div>
  <div class="grid grid-cols-2 gap-[9px] md:grid-cols-3 md:gap-4">
    {manufacturerStats.map((s) => (
      <div class="flex flex-col gap-2 rounded-md bg-navy-3 px-3.5 py-4 md:gap-3 md:rounded-lg md:p-6">
        <p class="flex items-baseline gap-1.5 font-mono text-[32px] leading-none font-normal tracking-[-2.34px] text-white md:text-[36px] md:tracking-[-3.12px]">
          {s.value}{s.unit && <span class="text-[14px] leading-[1.35] tracking-normal text-on-dark-muted">{s.unit}</span>}
        </p>
        <p class="text-[14px] leading-[1.5] text-on-dark-muted">{s.label}</p>
      </div>
    ))}
  </div>
  <div class="flex flex-wrap items-center gap-1.5 md:gap-3 md:pt-2">
    <span class:list={[mono, 'mr-1.5 hidden text-on-dark-muted md:inline']}>Certificaciones</span>
    {certifications.map((c) => (
      <span class:list={[mono, 'inline-flex items-center gap-2 rounded-pill bg-navy-3 py-2 pr-3.5 pl-3 text-white']}>
        <span class="size-1.5 rounded-full bg-gold"></span>{c}
      </span>
    ))}
  </div>
</section>

<!-- 03 Tecnología -->
<section class="flex flex-col gap-4 rounded-lg bg-surface px-5 pt-9 pb-5 md:gap-10 md:rounded-xl md:px-12 md:pt-[72px] md:pb-8" aria-labelledby="tecnologia">
  <div class="flex items-start justify-between">
    <div class="flex flex-col gap-5 md:pt-28">
      <IndexedLabel index="03" label="Tecnología" />
      <h2 id="tecnologia" class:list={[h2, 'text-ink']}>Cinco tecnologías<br class="hidden md:inline" /> en cada robot.</h2>
    </div>
    <div class="hidden h-[260px] w-[420px] shrink-0 overflow-hidden rounded-lg md:block">
      <img src="/assets/nosotros/tecnologia.jpg" alt="" loading="lazy" class="size-full object-cover" />
    </div>
  </div>
  <ol class="flex flex-col">
    {technologies.map((t, i) => (
      <li class:list={['flex gap-3.5 border-t border-line pt-3.5 pb-3 md:items-center md:gap-8 md:py-6', i === technologies.length - 1 && 'md:border-b']}>
        <span class:list={[mono, 'pt-1 text-gold md:pt-0']}>{String(i + 1).padStart(2, '0')}</span>
        <div class="flex flex-1 flex-col gap-1 md:flex-row md:items-center md:gap-8">
          <h3 class="text-[17px] leading-[1.3] font-medium tracking-[-0.5px] text-ink md:w-[420px] md:shrink-0 md:text-[28px] md:leading-[1.15] md:tracking-[-1.17px]">{t.title}</h3>
          <p class="text-[14px] leading-[1.5] text-muted md:flex-1 md:text-[16px] md:leading-[1.55] md:tracking-[-0.2px]">{t.text}</p>
        </div>
        <Glyph name={t.glyph} class="hidden md:grid" />
      </li>
    ))}
  </ol>
</section>

<!-- 04 Presencia -->
<section class="flex flex-col gap-4 rounded-lg bg-surface px-5 pt-9 pb-5 md:flex-row md:gap-16 md:rounded-xl md:px-12 md:pt-[72px] md:pb-8" aria-labelledby="presencia">
  <div class="flex flex-col gap-5 md:w-[553px] md:shrink-0">
    <IndexedLabel index="04" label="Presencia" />
    <h2 id="presencia" class:list={[h2, 'text-ink']}>Cerca de tu operación.</h2>
    <p class="hidden w-[360px] text-[16px] leading-[1.55] tracking-[-0.2px] text-muted md:block">Oficinas en Colombia, Ecuador y Estados Unidos, con cobertura en Latinoamérica y el Caribe.</p>
    <Button class="hidden w-fit md:inline-flex" label="Contactar a un asesor" href="/contacto" variant="gold" />
  </div>
  <div class="grid grid-cols-2 gap-[9px] md:flex-1 md:gap-4 md:content-start">
    {offices.map((o) => (
      <div class="flex flex-col gap-1 rounded-md bg-surface-2 p-3.5 md:gap-10 md:rounded-lg md:p-6">
        <Icon name="pin" size={20} class="hidden text-ink md:inline-flex" />
        <div class="flex flex-col gap-1">
          <p class="text-[17px] leading-[1.3] font-medium tracking-[-0.5px] text-ink md:text-[28px] md:leading-[1.15] md:tracking-[-1.17px]">{o.city}</p>
          <p class:list={[mono, 'text-muted']}><span class="md:hidden">{o.countryMobile}</span><span class="hidden md:inline">{o.country}</span></p>
        </div>
      </div>
    ))}
  </div>
</section>
