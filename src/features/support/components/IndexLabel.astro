---
// "Section Label" con índice: cuadrado dorado + "01" + línea + texto (Figma: Section Label con Index visible).
interface Props { index: string; label: string; tone?: 'surface' | 'panel'; class?: string }
const { index, label, tone = 'surface', class: className } = Astro.props;
const panel = tone === 'panel';
---
<div class:list={['flex items-center gap-2.5 font-mono text-[11.5px] leading-[1.2] font-medium tracking-[0.92px] uppercase', className]}>
  <span class="size-2 bg-gold"></span>
  <span class:list={[panel ? 'text-on-dark-muted' : 'text-muted']}>{index}</span>
  <span class:list={['h-px w-6', panel ? 'bg-on-dark-muted' : 'bg-subtle']}></span>
  <span class:list={[panel ? 'text-white' : 'text-ink']}>{label}</span>
</div>
