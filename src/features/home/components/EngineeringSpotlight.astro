---
// Home · Engineering Spotlight (Figma 2:13853). Panel oscuro: título 72 px + foto con panel de vidrio
// (escritorio) o tarjetas apiladas (móvil) + fila de specs.
import SectionHeader from '@/components/sections/SectionHeader.astro';
import StatCard from '@/components/sections/StatCard.astro';
import IconCircle from '@/components/sections/IconCircle.astro';
import { spotlight as s } from '@/app/data/home';
---

<section class="flex flex-col gap-7 rounded-lg bg-panel px-5 pt-10 pb-6 lg:gap-12 lg:rounded-xl lg:px-12 lg:pt-18 lg:pb-12">
  <SectionHeader
    index="03"
    label={s.label}
    title={s.title}
    titleMobile={s.titleMobile}
    description={s.description}
    descriptionClass="hidden text-[19px] leading-normal tracking-[-0.095px] lg:block lg:w-[420px]"
    size="xl"
    onDark
  />
  <p class="text-[15px] leading-[1.55] tracking-[-0.03px] text-on-dark-muted lg:hidden">{s.descriptionMobile}</p>

  <div class="relative h-[240px] overflow-clip rounded-md lg:h-[560px] lg:rounded-lg">
    <img src={s.image.src} alt={s.image.alt} loading="lazy" class="absolute inset-0 size-full object-cover" />
    <!-- Panel de vidrio · escritorio -->
    <div class="absolute top-6 right-6 hidden w-[560px] flex-col gap-4 rounded-lg bg-white p-5 text-navy backdrop-blur-2xl lg:flex">
      <div class="flex items-center justify-between">
        <div class="flex flex-col gap-1">
          <p class="text-[28px] leading-[1.15] font-medium tracking-[-0.42px]">{s.product.name}</p>
          <p class="text-[14px] leading-normal text-navy/60">{s.product.subtitle}</p>
        </div>
        <a href={s.product.href} aria-label={`Ver ${s.product.name}`} class="transition-opacity hover:opacity-80">
          <IconCircle tone="dark" />
        </a>
      </div>
      <ul class="flex items-start gap-2.5">
        {
          s.features.map((f) => (
            <li class="flex min-w-px flex-1 flex-col gap-2 rounded-sm bg-white px-3.5 pt-3.5 pb-4">
              <p class="text-[17px] leading-[1.3] font-medium tracking-[-0.085px]">{f.title}</p>
              <p class="text-[14px] leading-normal text-navy/60">{f.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <!-- Tarjetas · móvil -->
  <ul class="flex flex-col gap-2 lg:hidden">
    {
      s.features.map((f) => (
        <li class="flex flex-col gap-1.5 rounded-sm bg-navy-3 px-4 py-3.5">
          <p class="text-[17px] leading-[1.3] font-medium tracking-[-0.085px] text-white">{f.title}</p>
          <p class="text-[14px] leading-normal text-on-dark-muted">{f.descriptionMobile}</p>
        </li>
      ))
    }
  </ul>

  <div class="grid grid-cols-2 lg:flex">
    {
      s.specs.map((spec) => (
        <StatCard
          value={spec.value}
          unit={spec.unit}
          label={spec.label}
          labelMobile={spec.labelMobile}
          onDark
          class:list={[
            'border-t border-line-dark py-4 lg:flex-1 lg:basis-0 lg:pt-7 lg:pb-0 lg:pl-6 lg:first:pl-0',
            spec.desktopOnly && 'hidden lg:flex',
          ]}
        />
      ))
    }
  </div>
</section>
