---
// Home · Respaldo de fábrica (Figma 2:13758). Texto + 4 cifras (en línea, divisores verticales en escritorio).
import StatCard from '@/components/sections/StatCard.astro';
import { backing } from '@/app/data/home';
---

<section class="flex flex-col gap-6 rounded-lg bg-surface px-5 pt-7 pb-6 lg:flex-row lg:items-center lg:justify-between lg:rounded-xl lg:px-12 lg:py-11">
  <div class="flex flex-col gap-3 lg:w-[400px] lg:shrink-0 lg:gap-3.5">
    <div class="flex items-center gap-2.5">
      <span class="size-2 bg-gold"></span>
      <span class="font-mono text-[11.5px] leading-[1.2] font-medium tracking-[0.92px] text-ink uppercase">{backing.label}</span>
    </div>
    <p class="text-[19px] leading-[1.2] font-medium tracking-[-0.21px] text-ink lg:leading-[1.25]">{backing.text}</p>
  </div>
  <div class="grid grid-cols-2 lg:flex">
    {
      backing.stats.map((s) => (
        <StatCard
          value={s.value}
          unit={s.unit}
          unitMobile={s.unitMobile}
          label={s.label}
          labelMobile={s.labelMobile}
          class="border-t border-line py-4 lg:border-t-0 lg:shrink-0 lg:border-l lg:px-7 lg:py-0 lg:whitespace-nowrap lg:first:border-l-0"
        />
      ))
    }
  </div>
</section>
