---
// Home · Líneas de producto (Figma 2:13783). Lista de 5 líneas (la primera destacada) + foto con
// los modelos de recepción (escritorio). En móvil la línea activa lleva la foto dentro.
import SectionHeader from '@/components/sections/SectionHeader.astro';
import IconCircle from '@/components/sections/IconCircle.astro';
import { productLines, productLinesCopy as c, receptionModels } from '@/app/data/home';

const [active, ...others] = productLines;
const mono = 'font-mono text-[11.5px] leading-[1.2] font-medium tracking-[0.92px] uppercase';
---

<section class="flex flex-col gap-7 rounded-lg bg-surface px-5 pt-10 pb-6 lg:gap-12 lg:rounded-xl lg:px-12 lg:pt-18 lg:pb-12">
  <SectionHeader index="01" label={c.label} title={c.title} titleMobile={c.titleMobile} description={c.description} />

  <div class="flex flex-col gap-2 lg:flex-row lg:gap-6">
    <ul class="flex flex-col gap-2 lg:min-w-0 lg:flex-1">
      <!-- Línea activa · móvil -->
      <li class="lg:hidden">
        <a href={active.href} class="flex flex-col gap-4 rounded-md bg-panel pt-3 pr-2.5 pb-4 pl-4 text-white">
          <span class="flex items-center gap-3.5">
            <span class:list={[mono, 'text-gold-soft']}>01</span>
            <span class="min-w-px flex-1 text-[19px] leading-[1.2] font-medium tracking-[-0.21px]">{active.name}</span>
            <span class="font-mono text-[14px] leading-[1.35] text-on-dark-muted">{active.countLabel}</span>
            <IconCircle tone="gold" size={36} />
          </span>
          <img src={c.media.src} alt={c.media.alt} loading="lazy" class="h-[200px] w-full rounded-sm object-cover" />
          <span class="text-[14px] leading-normal text-on-dark-muted">{active.description}</span>
        </a>
      </li>
      <!-- Línea activa · escritorio -->
      <li class="hidden lg:block">
        <a href={active.href} class="flex items-center gap-6 rounded-lg bg-ink py-[22px] pr-4 pl-7">
          <span class:list={[mono, 'text-gold-soft']}>01</span>
          <span class="flex min-w-px flex-1 flex-col gap-1.5">
            <span class="text-[28px] leading-[1.15] font-medium tracking-[-0.42px] text-inverse">{active.name}</span>
            <span class="max-w-[380px] text-[14px] leading-normal text-on-dark-muted">{active.description}</span>
          </span>
          <span class="font-mono text-[14px] leading-[1.35] text-on-dark-muted">{active.countLabel}</span>
          <IconCircle tone="gold" />
        </a>
      </li>

      {
        others.map((line, i) => (
          <li>
            <a
              href={line.href}
              class="group flex items-center gap-3.5 rounded-md bg-surface-2 py-3 pr-2.5 pl-4 transition-colors hover:bg-stage lg:gap-6 lg:rounded-lg lg:py-[22px] lg:pr-4 lg:pl-7"
            >
              <span class:list={[mono, 'text-muted']}>{String(i + 2).padStart(2, '0')}</span>
              <span class="min-w-px flex-1 text-[19px] leading-[1.2] font-medium tracking-[-0.21px] text-ink lg:text-[28px] lg:leading-[1.15] lg:tracking-[-0.42px]">
                {line.name}
              </span>
              <span class="font-mono text-[14px] leading-[1.35] text-muted">{line.countLabel}</span>
              <IconCircle tone="outline" size={36} class="lg:size-11" />
            </a>
          </li>
        ))
      }
    </ul>

    <div class="relative hidden overflow-clip rounded-lg lg:block lg:w-[640px] lg:shrink-0">
      <img src={c.media.src} alt={c.media.alt} loading="lazy" class="absolute inset-0 size-full object-cover" />
      <div class="absolute inset-x-5 bottom-5 flex flex-col gap-3 rounded-md bg-white px-5 py-[18px] text-navy backdrop-blur-xl">
        <p class:list={[mono, 'text-navy/60']}>{c.modelsTitle}</p>
        <ul class="flex flex-wrap gap-2">
          {
            receptionModels.map((m) => (
              <li>
                <a href={m.href} class="block rounded-pill border border-navy px-3.5 py-2 text-[14px] leading-[1.2] transition-colors hover:bg-navy hover:text-white">
                  {m.nombre}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
