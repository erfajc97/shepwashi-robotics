---
// Home · Aplicaciones (Figma 2:13979). Escritorio: tarjeta grande + 4 tarjetas 2×2 con fotos.
// Móvil: tarjeta grande + lista de filas con miniatura.
import SectionHeader from '@/components/sections/SectionHeader.astro';
import CategoryTag from '@/components/sections/CategoryTag.astro';
import IconCircle from '@/components/sections/IconCircle.astro';
import { applications, applicationsCopy as c } from '@/app/data/home';

const [main, ...rest] = applications;
---

<section class="flex flex-col gap-7 rounded-lg bg-surface px-5 pt-10 pb-6 lg:gap-10 lg:rounded-xl lg:px-12 lg:pt-18 lg:pb-12">
  <SectionHeader index="05" label={c.label} title={c.title} description={c.description} />

  <div class="flex flex-col gap-7 lg:grid lg:grid-cols-2 lg:gap-4">
    <a href={c.href} class="group relative flex h-[400px] flex-col justify-end overflow-clip rounded-md p-3.5 lg:h-[640px] lg:min-w-0 lg:rounded-lg lg:p-5">
      <img src={main.image} alt="" loading="lazy" class="absolute inset-0 size-full object-cover transition-transform duration-500 group-hover:scale-105" />
      <span class="shade-main absolute inset-0"></span>
      <CategoryTag label={main.tag} tone="white" class="absolute top-3.5 left-3.5 lg:top-4 lg:left-4" />
      <span class="relative flex items-end justify-between gap-6">
        <span class="flex flex-col gap-2 lg:max-w-[488px] lg:gap-2.5">
          <span class="text-[21px] leading-[1.2] font-medium tracking-[-0.21px] text-white lg:text-[40px] lg:leading-[1.08] lg:tracking-[-1px]">{main.title}</span>
          <span class="text-[14px] leading-normal text-white/80 lg:max-w-[468px] lg:text-[16px] lg:leading-[1.55] lg:tracking-[-0.032px]">
            <span class="lg:hidden">{main.descriptionMobile}</span>
            <span class="hidden lg:inline">{main.description}</span>
          </span>
        </span>
        <IconCircle tone="glass" class="hidden lg:grid" />
      </span>
    </a>

    <!-- Tarjetas · escritorio -->
    <ul class="hidden grid-cols-2 gap-4 lg:grid lg:min-w-0">
      {
        rest.map((a) => (
          <li>
            <a href={c.href} class="group relative flex h-[312px] flex-col justify-end overflow-clip rounded-lg p-5">
              <img src={a.image} alt="" loading="lazy" class="absolute inset-0 size-full object-cover transition-transform duration-500 group-hover:scale-105" />
              <span class="shade-main absolute inset-0"></span>
              <CategoryTag label={a.tag} tone="white" class="absolute top-4 left-4" />
              <span class="relative flex items-end justify-between gap-6">
                <span class="max-w-[212px] text-[21px] leading-[1.25] font-medium tracking-[-0.21px] text-white">{a.title}</span>
                <IconCircle tone="glass" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Filas · móvil -->
    <ul class="flex flex-col lg:hidden">
      {
        rest.map((a) => (
          <li class="border-t border-line">
            <a href={c.href} class="flex items-center gap-3.5 py-3.5">
              <img src={a.image} alt="" loading="lazy" class="size-[72px] shrink-0 rounded-sm object-cover" />
              <span class="flex min-w-px flex-1 flex-col gap-1">
                <span class="font-mono text-[11.5px] leading-[1.2] font-medium tracking-[0.92px] text-muted uppercase">{a.tag}</span>
                <span class="text-[17px] leading-[1.3] font-medium tracking-[-0.085px] text-ink">{a.title}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Degradado del Figma: transparente hasta ~30–35 % → #050f1f (navy fijo) al 90 % abajo. */
  .shade-main {
    background: linear-gradient(to bottom, transparent 30%, color-mix(in srgb, var(--c-navy) 90%, transparent) 100%);
  }
</style>
