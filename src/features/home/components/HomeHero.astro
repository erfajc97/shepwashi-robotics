---
// Home · Hero (Figma 2:13725 / móvil). Título gigante + lead + CTAs y foto con chip "En operación",
// capacidades (solo escritorio) y tarjeta Spotlight del producto.
import Button from '@/components/ui/Button.astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import IconCircle from '@/components/sections/IconCircle.astro';
import { hero } from '@/app/data/home';

const s = hero.spotlight;
---

<section class="flex flex-col gap-6 px-1 pt-8 lg:gap-10 lg:px-0 lg:pt-14" aria-labelledby="home-hero-title">
  <div class="flex flex-col gap-6 min-[1360px]:flex-row min-[1360px]:items-end min-[1360px]:justify-between min-[1360px]:px-8">
    <div class="flex flex-col gap-6 lg:gap-7">
      <SectionLabel label={hero.labelMobile} class="lg:hidden" />
      <SectionLabel label={hero.label} class="hidden lg:flex" />
      <h1
        id="home-hero-title"
        class="text-[40px] leading-[0.95] font-medium tracking-[-1.62px] text-ink md:text-[56px] md:tracking-[-2.25px] min-[1360px]:text-[72px] min-[1360px]:leading-[0.94] min-[1360px]:tracking-[-3.37px]"
      >
        {hero.titleLine1}{' '}<br class="hidden min-[1360px]:block" />{hero.titleLine2}
      </h1>
    </div>
    <div class="flex flex-col gap-6 lg:gap-7 min-[1360px]:w-[411px] min-[1360px]:shrink-0">
      <p class="text-[15px] leading-[1.55] tracking-[-0.03px] text-ink-2 lg:max-w-[380px] lg:text-[17px] lg:leading-normal lg:tracking-[-0.095px]">
        {hero.lead}
      </p>
      <div class="flex flex-col gap-2.5 lg:flex-row lg:gap-3">
        <Button label={hero.primary.label} href={hero.primary.href} variant="gold" class="w-full justify-between lg:w-auto lg:justify-start" />
        <Button label={hero.secondary.label} href={hero.secondary.href} variant="secondary" class="w-full justify-between lg:w-auto lg:justify-start" />
      </div>
    </div>
  </div>

  <div class="relative h-[min(460px,52svh)] overflow-clip rounded-lg lg:h-[min(640px,62svh)] lg:rounded-xl">
    <img src={hero.image.src} alt={hero.image.alt} fetchpriority="high" class="absolute inset-0 size-full object-cover" />
    <div class="absolute inset-0 hidden bg-linear-to-b from-transparent from-55% to-navy/55 lg:block"></div>

    <span class="absolute top-3 left-3 flex items-center gap-2 rounded-pill bg-navy py-2 pr-3.5 pl-3 font-mono text-[11.5px] leading-[1.2] font-medium tracking-[0.92px] whitespace-nowrap text-white uppercase lg:top-7 lg:left-7 lg:py-2.5 lg:pr-4 lg:pl-3.5">
      <span class="size-1.5 rounded-pill bg-gold-soft lg:size-[7px]"></span>
      <span class="lg:hidden">{hero.liveMobile}</span>
      <span class="hidden lg:inline">{hero.live}</span>
    </span>

    <ul class="absolute bottom-7 left-7 hidden gap-2 lg:flex">
      {
        hero.capabilities.map((c) => (
          <li class="rounded-pill border border-white/32 bg-white/16 px-4 py-2.5 text-[14px] leading-[1.2] text-white backdrop-blur-lg">{c}</li>
        ))
      }
    </ul>

    <!-- Spotlight card · escritorio -->
    <a
      href={s.href}
      class="absolute right-7 bottom-7 hidden w-[386px] flex-col gap-4 rounded-lg bg-white p-4 text-navy transition-transform hover:-translate-y-0.5 lg:flex"
    >
      <div class="flex items-center gap-4">
        <img src={s.image} alt="" class="h-24 w-[84px] shrink-0 rounded-sm object-cover" />
        <div class="flex flex-col gap-1.5">
          <p class="text-[19px] leading-[1.25] font-medium tracking-[-0.21px]">{s.name}</p>
          <p class="text-[14px] leading-normal whitespace-pre-line text-navy/60">{s.description}</p>
        </div>
      </div>
      <div class="flex items-center justify-between border-t border-navy/15 pt-3.5">
        <span class="font-mono text-[11.5px] leading-[1.2] font-medium tracking-[0.92px] text-navy/60 uppercase">{s.meta}</span>
        <IconCircle tone="dark" size={36} />
      </div>
    </a>

    <!-- Spotlight card · móvil -->
    <a href={s.href} class="absolute inset-x-3 bottom-3 flex items-center gap-3 rounded-md bg-white py-2.5 pr-3 pl-2.5 text-navy lg:hidden">
      <img src={s.image} alt="" class="h-16 w-14 shrink-0 rounded-sm object-cover" />
      <div class="flex min-w-px flex-1 flex-col gap-0.5">
        <p class="text-[17px] leading-[1.3] font-medium tracking-[-0.085px]">{s.name}</p>
        <p class="text-[14px] leading-normal text-navy/60">{s.descriptionMobile}</p>
      </div>
      <IconCircle tone="dark" size={36} />
    </a>
  </div>
</section>
